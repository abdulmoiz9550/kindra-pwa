<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <!-- Local database on the Render persistent disk mounted at /opt/traccar/data -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Phones running Traccar Client (OsmAnd protocol) on Render's public port -->
    <entry key='osmand.port'>__PORT__</entry>
    <!-- Web UI only inside the container (Render exposes a single port) -->
    <entry key='web.port'>8082</entry>
    <!-- New phones are created automatically on first report; Kindra links them by their identifier (IMEI field) -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Forward every position and event to Kindra (JSON: { position, device } / { event, position, device }) -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.json'>true</entry>
    <entry key='forward.url'>__FORWARD_URL__</entry>
    <entry key='event.forward.enable'>true</entry>
    <entry key='event.forward.url'>__FORWARD_URL__</entry>

    <!-- Device events used by Kindra: ignition, power cut, tampering, loss of signal -->
    <entry key='event.enable'>true</entry>
    <entry key='event.ignitionHandler'>true</entry>
    <entry key='status.timeout'>300</entry>
</properties>
