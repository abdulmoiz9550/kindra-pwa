{
  "name": "@kindra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "backup": "tsx src/scripts/backup.ts",
    "db:schema": "tsx src/scripts/applySchema.ts",
    "reset-2fa": "tsx src/scripts/reset2fa.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@kindra/shared": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nanoid": "^5.1.5",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0"
  }
}
