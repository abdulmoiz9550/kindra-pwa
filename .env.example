# ---- Servidor ----
PORT=4000
JWT_SECRET=cambia-este-secreto-en-produccion
# memory | postgres  (memory es el modo de pruebas; postgres se activa solo con variables)
DB_DRIVER=memory
# Solo para DB_DRIVER=postgres
DATABASE_URL=postgres://usuario:clave@host:5432/kindra
DATABASE_SSL=false
# Solo para DB_DRIVER=memory: guarda el estado en server/data/db.json para sobrevivir reinicios
PERSIST_FILE=true
# Habilita cambio rápido de rol, usuarios de prueba y etiqueta "Datos simulados"
DEMO_MODE=true
# Semilla automática de datos simulados si la base está vacía
SEED_ON_EMPTY=true
# Umbral de diferencia entre hora de dispositivo y servidor (minutos)
TIME_SKEW_MINUTES=30
# Carpeta de fotos
UPLOAD_DIR=./data/uploads
# URL pública usada en enlaces y QR
PUBLIC_BASE_URL=http://localhost:5173
# Opcional: clasificación de intención de AURA con modelo de lenguaje
ANTHROPIC_API_KEY=
AURA_MODEL=claude-opus-5-5
# Intervalo del planificador de escalamientos (segundos)
JOBS_INTERVAL_SECONDS=60
