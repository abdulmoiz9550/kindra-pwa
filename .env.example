# ---- Servidor ----
PORT=4000
JWT_SECRET=cambia-este-secreto-en-produccion
# memory | postgres  (memory es el modo de pruebas; postgres se activa solo con variables)
DB_DRIVER=memory
# Solo para DB_DRIVER=postgres
DATABASE_URL=postgres://usuario:clave@host:5432/kindra
DATABASE_SSL=false
# Solo para DB_DRIVER=memory: guarda el estado en server/data/db.json para sobrevivir reinicios
PERSIST_FILE=true
# Habilita cambio rápido de rol, usuarios de prueba y etiqueta "Datos simulados"
DEMO_MODE=true
# Semilla automática de datos simulados si la base está vacía
SEED_ON_EMPTY=true
# Umbral de diferencia entre hora de dispositivo y servidor (minutos)
TIME_SKEW_MINUTES=30
# Carpeta de fotos
UPLOAD_DIR=./data/uploads
# URL pública usada en enlaces y QR
PUBLIC_BASE_URL=http://localhost:5173
# Opcional: clasificación de intención de AURA con modelo de lenguaje
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Intervalo del planificador de escalamientos (segundos)
JOBS_INTERVAL_SECONDS=60
# Seguimiento GPS (addendum v1.3): servidor Traccar propio. Vacío = solo teléfono del escolta y puntos de control.
TRACCAR_URL=
TRACCAR_TOKEN=
TRACCAR_USER=
TRACCAR_PASSWORD=
# Secreto para el reenvío de posiciones/eventos desde Traccar a /api/tracking/traccar/forward?secret=...
TRACCAR_FORWARD_SECRET=
# Rutas planificadas: servidor OSRM (por defecto el público). "off" = línea recta.
OSRM_URL=

# Fotos permanentes. Sin esta clave se guardan en la base de Supabase.
SUPABASE_SERVICE_KEY=
